{
  "expo": {
    "name": "CDShop",
    "slug": "fashion-ecommerce-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": [
      "fashion-ecommerce",
      "com.fashionshop.app"
    ],
    "extra": {
      "EAS_PROJECT_ID": "a6a0028f-0aa6-440c-93f9-34b15a6773d6",
      "eas": {
        "projectId": "a6a0028f-0aa6-440c-93f9-34b15a6773d6"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fashionshop.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Ứng dụng cần truy cập thư viện ảnh để chọn và lưu ảnh thử đồ.",
        "NSPhotoLibraryAddUsageDescription": "Ứng dụng cần quyền lưu ảnh để tải kết quả thử đồ về máy.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.fashionshop.app",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần truy cập thư viện ảnh để chọn ảnh thử đồ."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Ứng dụng cần truy cập thư viện ảnh để lưu kết quả thử đồ.",
          "savePhotosPermission": "Ứng dụng cần quyền lưu ảnh để tải kết quả thử đồ về máy."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      "expo-video"
    ]
  }
}
