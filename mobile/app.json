{
  "expo": {
    "name": "Fashion E-commerce Mobile",
    "slug": "fashion-ecommerce-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "fashion-ecommerce",
    "extra": {
      "GOOGLE_CLIENT_ID": "",
      "FACEBOOK_APP_ID": "",
      "EAS_PROJECT_ID": "a6a0028f-0aa6-440c-93f9-34b15a6773d6",
      "eas": {
        "projectId": "a6a0028f-0aa6-440c-93f9-34b15a6773d6"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fashionshop.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Ứng dụng cần truy cập thư viện ảnh để cập nhật ảnh đại diện.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.fashionshop.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần truy cập thư viện ảnh để cập nhật ảnh đại diện."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-notifications"
    ]
  }
}
