# Optional host ports
WEB_PORT=8080
BACKEND_PORT=5000
IMAGE_VALIDATION_PORT=7001
GARMENT_PROCESSING_PORT=7002
VISUAL_SEARCH_PORT=8001

# Browser-facing URLs. Production deployment sets these from ops/deploy-production.sh.
# For local Docker development, change localhost to your LAN IP when testing from another device.
DOCKER_FRONTEND_URL=http://localhost:8080
DOCKER_FRONTEND_URL_ALT=http://127.0.0.1:8080
DOCKER_API_BASE_URL=http://localhost:5000/api
DOCKER_PUBLIC_API_BASE_URL=http://localhost:5000
