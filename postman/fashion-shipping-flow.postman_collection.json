            },
            "url": {
              "raw": "{{base_url}}/shipping/webhooks/simulated",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "shipping",
                "webhooks",
                "simulated"
              ]
            },
            "description": "Unauthenticated webhook route. Set webhook_secret to backend SHIPPING_WEBHOOK_SECRET first."
          },
          "response": []
        }
      ]
    }
  ]
