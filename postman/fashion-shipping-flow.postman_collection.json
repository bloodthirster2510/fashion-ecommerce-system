{
  "info": {
    "_postman_id": "b1a67c03-7300-4fd6-9e53-6513d7768f7b",
    "name": "Fashion Ecommerce - Shipping Flow",
    "description": "Admin Postman flow for local shipping tests. Import the Fashion Local environment, set admin_password, then run requests from top to bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{admin_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('base_url')) {",
          "  pm.environment.set('base_url', 'http://localhost:5000/api');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Auth",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{admin_identifier}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/admin/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "admin",
                "login"
              ]
            },
            "description": "Logs in with an admin or staff account and stores admin_token."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const result = pm.response.json();",
                  "const token = result && result.data && result.data.accessToken;",
                  "",
                  "pm.test('access token exists', function () {",
                  "  pm.expect(token).to.be.a('string');",
                  "  pm.expect(token.length).to.be.greaterThan(10);",
                  "});",
                  "",
                  "if (token) {",
                  "  pm.environment.set('admin_token', token);",
                  "}",
                  "",
                  "if (result && result.data && result.data.user) {",
                  "  pm.environment.set('admin_user', JSON.stringify(result.data.user));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Prepare Order",
      "item": [
        {
          "name": "List Confirmed Orders - Save First order_id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/orders?status=confirmed&page=1&limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "orders"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "confirmed"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Finds confirmed orders and stores the first _id into order_id. If no order is found, create an order first or paste order_id manually."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('orders list returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const result = pm.response.json();",
                  "const items = result && result.data && Array.isArray(result.data.items) ? result.data.items : [];",
                  "",
                  "pm.test('response contains items array', function () {",
                  "  pm.expect(items).to.be.an('array');",
                  "});",
                  "",
                  "if (items.length > 0) {",
                  "  const order = items[0];",
                  "  pm.environment.set('order_id', order._id);",
                  "  if (order.orderCode) {",
                  "    pm.environment.set('order_code', order.orderCode);",
                  "  }",
                  "  const ownerId = order.user_id || order.userId || (order.user && (order.user._id || order.user.id)) || '';",
                  "  if (ownerId) {",
                  "    pm.environment.set('order_user_id', ownerId);",
                  "  }",
                  "  pm.environment.set('order_status', order.status || '');",
                  "  pm.environment.set('payment_method', order.paymentMethod || '');",
                  "  pm.environment.set('payment_status', order.paymentStatus || '');",
                  "  if (order.shipping && order.shipping.trackingCode) {",
                  "    pm.environment.set('tracking_code', order.shipping.trackingCode);",
                  "  }",
                  "} else {",
                  "  console.warn('No confirmed orders found. Create an order first or paste order_id manually.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Find Order by order_keyword - Save order_id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/orders?keyword={{order_keyword}}&page=1&limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "orders"
              ],
              "query": [
                {
                  "key": "keyword",
                  "value": "{{order_keyword}}"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Paste the orderCode shown on mobile into order_keyword, then run this request to make the rest of the shipping flow target the same order."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('order search returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const result = pm.response.json();",
                  "const items = result && result.data && Array.isArray(result.data.items) ? result.data.items : [];",
                  "const keyword = (pm.environment.get('order_keyword') || '').trim();",
                  "",
                  "pm.test('response contains items array', function () {",
                  "  pm.expect(items).to.be.an('array');",
                  "});",
                  "",
                  "if (keyword) {",
                  "  pm.test('found at least one matching order', function () {",
                  "    pm.expect(items.length).to.be.above(0);",
                  "  });",
                  "}",
                  "",
                  "if (items.length > 0) {",
                  "  const order = items[0];",
                  "  pm.environment.set('order_id', order._id);",
                  "  if (order.orderCode) {",
                  "    pm.environment.set('order_code', order.orderCode);",
                  "  }",
                  "  const ownerId = order.user_id || order.userId || (order.user && (order.user._id || order.user.id)) || '';",
                  "  if (ownerId) {",
                  "    pm.environment.set('order_user_id', ownerId);",
                  "  }",
                  "  pm.environment.set('order_status', order.status || '');",
                  "  pm.environment.set('payment_method', order.paymentMethod || '');",
                  "  pm.environment.set('payment_status', order.paymentStatus || '');",
                  "  pm.environment.set('shipping_status', order.shipping && order.shipping.status ? order.shipping.status : '');",
                  "  if (order.shipping && order.shipping.trackingCode) {",
                  "    pm.environment.set('tracking_code', order.shipping.trackingCode);",
                  "  }",
                  "} else {",
                  "  console.warn('No order matched order_keyword. Paste the mobile orderCode exactly, or paste order_id manually.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/orders/{{order_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "orders",
                "{{order_id}}"
              ]
            },
            "description": "Reads the current order and refreshes local environment variables."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('order detail returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const result = pm.response.json();",
                  "const order = result && result.data;",
                  "",
                  "if (order) {",
                  "  pm.environment.set('order_id', order._id || pm.environment.get('order_id'));",
                  "  if (order.orderCode) {",
                  "    pm.environment.set('order_code', order.orderCode);",
                  "  }",
                  "  const ownerId = order.user_id || order.userId || (order.user && (order.user._id || order.user.id)) || '';",
                  "  if (ownerId) {",
                  "    pm.environment.set('order_user_id', ownerId);",
                  "  }",
                  "  pm.environment.set('order_status', order.status || '');",
                  "  pm.environment.set('payment_method', order.paymentMethod || '');",
                  "  pm.environment.set('payment_status', order.paymentStatus || '');",
                  "  pm.environment.set('shipping_status', order.shipping && order.shipping.status ? order.shipping.status : '');",
                  "  if (order.shipping && order.shipping.trackingCode) {",
                  "    pm.environment.set('tracking_code', order.shipping.trackingCode);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Only Online - Mark Current Order Paid",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentStatus\": \"paid\",\n  \"reason\": \"Postman shipping flow setup\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/payments/orders/{{order_id}}/payment-status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "payments",
                "orders",
                "{{order_id}}",
                "payment-status"
              ]
            },
            "description": "Use only for VNPAY or other online payment orders. Do not run for COD: COD stays pending until the parcel is delivered, then the delivered webhook/confirm step marks it paid."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const paymentMethod = (pm.environment.get('payment_method') || '').toUpperCase();",
                  "if (paymentMethod === 'COD') {",
                  "  console.warn('Skipping payment update: COD should remain pending until delivered.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('payment update returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const result = pm.response.json();",
                  "const order = result && result.data;",
                  "if (order) {",
                  "  pm.environment.set('payment_status', order.paymentStatus || '');",
                  "  pm.environment.set('order_status', order.status || '');",
                  "}",
                  "",
                  "pm.test('paymentStatus is paid', function () {",
                  "  pm.expect(pm.environment.get('payment_status')).to.eql('paid');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Move Current Order To Packed",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"packed\",\n  \"reason\": \"Packed from Postman before shipping\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/orders/{{order_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "orders",
                "{{order_id}}",
                "status"
              ]
            },
            "description": "Shipping can only start from a packed order."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status update returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const result = pm.response.json();",
                  "const order = result && result.data;",
                  "if (order) {",
                  "  pm.environment.set('order_status', order.status || '');",
                  "  pm.environment.set('payment_status', order.paymentStatus || '');",
                  "}",
                  "",
                  "pm.test('order is packed', function () {",
                  "  pm.expect(pm.environment.get('order_status')).to.eql('packed');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Shipping Simulation",
      "item": [
        {
          "name": "Update Shipping Info",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('tracking_code', 'TEST-' + Date.now());",
                  "",
                  "const rawProviderCost = (pm.environment.get('actual_provider_cost') || '').trim();",
                  "if (!rawProviderCost || Number.isNaN(Number(rawProviderCost))) {",
                  "  pm.environment.set('actual_provider_cost', '25000');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('shipping update returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const result = pm.response.json();",
                  "const order = result && result.data;",
                  "if (order) {",
                  "  pm.environment.set('order_status', order.status || '');",
                  "  pm.environment.set('shipping_status', order.shipping && order.shipping.status ? order.shipping.status : '');",
                  "  if (order.shipping && order.shipping.trackingCode) {",
                  "    pm.environment.set('tracking_code', order.shipping.trackingCode);",
                  "  }",
                  "}",
                  "",
                  "pm.test('shipping status is ready', function () {",
                  "  pm.expect(pm.environment.get('shipping_status')).to.eql('ready');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"{{shipping_provider}}\",\n  \"status\": \"ready\",\n  \"trackingCode\": \"{{tracking_code}}\",\n  \"labelUrl\": \"{{shipping_label_url}}\",\n  \"actualProviderCost\": {{actual_provider_cost}},\n  \"reason\": \"Assigned test tracking from Postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/orders/{{order_id}}/shipping",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "orders",
                "{{order_id}}",
                "shipping"
              ]
            },
            "description": "Assigns a synthetic tracking code and sets shipping.status to ready."
          },
          "response": []
        },
        {
          "name": "Simulate Picked",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"picked\",\n  \"provider\": \"{{shipping_provider}}\",\n  \"trackingCode\": \"{{tracking_code}}\",\n  \"reason\": \"Carrier picked the parcel\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/orders/{{order_id}}/shipping-webhook-simulation",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "orders",
                "{{order_id}}",
                "shipping-webhook-simulation"
              ]
            },
            "description": "Simulates carrier pickup. The order moves to shipping if it was packed."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('picked simulation returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const order = pm.response.json().data;",
                  "if (order) {",
                  "  pm.environment.set('order_status', order.status || '');",
                  "  pm.environment.set('shipping_status', order.shipping && order.shipping.status ? order.shipping.status : '');",
                  "}",
                  "",
                  "pm.test('order is shipping after pickup', function () {",
                  "  pm.expect(pm.environment.get('order_status')).to.eql('shipping');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Simulate Shipping",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"shipping\",\n  \"provider\": \"{{shipping_provider}}\",\n  \"trackingCode\": \"{{tracking_code}}\",\n  \"reason\": \"Carrier is delivering the parcel\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/orders/{{order_id}}/shipping-webhook-simulation",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "orders",
                "{{order_id}}",
                "shipping-webhook-simulation"
              ]
            },
            "description": "Simulates in-transit shipping."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('shipping simulation returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const order = pm.response.json().data;",
                  "if (order) {",
                  "  pm.environment.set('order_status', order.status || '');",
                  "  pm.environment.set('shipping_status', order.shipping && order.shipping.status ? order.shipping.status : '');",
                  "}",
                  "",
                  "pm.test('shipping status is shipping', function () {",
                  "  pm.expect(pm.environment.get('shipping_status')).to.eql('shipping');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Simulate Delivered",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"delivered\",\n  \"provider\": \"{{shipping_provider}}\",\n  \"trackingCode\": \"{{tracking_code}}\",\n  \"deliveredAt\": \"{{$isoTimestamp}}\",\n  \"reason\": \"Carrier delivered the parcel\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/orders/{{order_id}}/shipping-webhook-simulation",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "orders",
                "{{order_id}}",
                "shipping-webhook-simulation"
              ]
            },
            "description": "Carrier delivery step. COD orders become paid here, but the order remains delivered until the customer confirms receipt."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('delivered simulation returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const order = pm.response.json().data;",
                  "if (order) {",
                  "  if (order.orderCode) {",
                  "    pm.environment.set('order_code', order.orderCode);",
                  "  }",
                  "  const ownerId = order.user_id || order.userId || (order.user && (order.user._id || order.user.id)) || '';",
                  "  if (ownerId) {",
                  "    pm.environment.set('order_user_id', ownerId);",
                  "  }",
                  "  pm.environment.set('order_status', order.status || '');",
                  "  pm.environment.set('payment_status', order.paymentStatus || '');",
                  "  pm.environment.set('shipping_status', order.shipping && order.shipping.status ? order.shipping.status : '');",
                  "}",
                  "",
                  "pm.test('order is delivered', function () {",
                  "  pm.expect(pm.environment.get('order_status')).to.eql('delivered');",
                  "});",
                  "",
                  "if ((pm.environment.get('payment_method') || '').toUpperCase() === 'COD') {",
                  "  pm.test('COD is paid only after delivery', function () {",
                  "    pm.expect(pm.environment.get('payment_status')).to.eql('paid');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark Completed - Simulate Customer Received",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\",\n  \"reason\": \"Postman simulate customer received parcel\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/orders/{{order_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "orders",
                "{{order_id}}",
                "status"
              ]
            },
            "description": "Admin-only shortcut for testing the customer received step. In the real app, the customer presses the received button and calls /orders/:id/confirm-received."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('completed update returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const order = pm.response.json().data;",
                  "if (order) {",
                  "  pm.environment.set('order_status', order.status || '');",
                  "  pm.environment.set('payment_status', order.paymentStatus || '');",
                  "  pm.environment.set('shipping_status', order.shipping && order.shipping.status ? order.shipping.status : '');",
                  "}",
                  "",
                  "pm.test('order is completed', function () {",
                  "  pm.expect(pm.environment.get('order_status')).to.eql('completed');",
                  "});",
                  "",
                  "pm.test('received timestamp exists', function () {",
                  "  pm.expect(order && order.receivedAt).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Optional GHN Real Shipment",
      "item": [
        {
          "name": "Create GHN Shipment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/orders/{{order_id}}/ghn-shipment",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "orders",
                "{{order_id}}",
                "ghn-shipment"
              ]
            },
            "description": "Requires GHN env variables and a packed order with GHN-mapped destination."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('GHN create returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const order = pm.response.json().data;",
                  "if (order && order.shipping) {",
                  "  pm.environment.set('shipping_status', order.shipping.status || '');",
                  "  if (order.shipping.trackingCode) {",
                  "    pm.environment.set('tracking_code', order.shipping.trackingCode);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Sync GHN Shipment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/orders/{{order_id}}/ghn-shipment/sync",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "orders",
                "{{order_id}}",
                "ghn-shipment",
                "sync"
              ]
            },
            "description": "Pulls current GHN status by tracking code and applies it as a shipping webhook."
          },
          "response": []
        },
        {
          "name": "Cancel GHN Shipment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Cancelled from Postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/orders/{{order_id}}/ghn-shipment/cancel",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "orders",
                "{{order_id}}",
                "ghn-shipment",
                "cancel"
              ]
            },
            "description": "Cancels a GHN shipment before delivery starts."
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Optional Public Webhook",
      "item": [
        {
          "name": "Public Simulated Shipping Webhook",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
