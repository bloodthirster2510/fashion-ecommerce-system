PORT=5000
SEED_DB=false
MONGODB_URI=mongodb://localhost:27017/fashion-ecommerce
MONGODB_CONNECT_RETRIES=3
MONGODB_CONNECT_RETRY_DELAY_MS=1000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:19006
FRONTEND_URL=http://localhost:5173
CATALOG_IMAGE_ALLOWED_HOSTS=res.cloudinary.com
REQUEST_BODY_LIMIT=2mb
ORDER_EVIDENCE_BODY_LIMIT=12mb
AVATAR_BODY_LIMIT=5mb
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=600
# Production defaults to MongoDB so limits are shared by all backend instances.
RATE_LIMIT_STORE=mongo
# Set to the exact number of trusted reverse proxies in front of Express; leave empty without a proxy.
TRUST_PROXY_HOPS=
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=60
REVIEW_CREATE_RATE_LIMIT_WINDOW_MS=3600000
REVIEW_CREATE_RATE_LIMIT_MAX=5
REVIEW_MUTATION_RATE_LIMIT_WINDOW_MS=3600000
REVIEW_MUTATION_RATE_LIMIT_MAX=20
REVIEW_HELPFUL_RATE_LIMIT_WINDOW_MS=3600000
REVIEW_HELPFUL_RATE_LIMIT_MAX=60
COUPON_LIFECYCLE_SCHEDULER=true
COUPON_LIFECYCLE_INTERVAL_MS=60000
SUPPORT_TICKET_LIFECYCLE_SCHEDULER=true
SUPPORT_TICKET_LIFECYCLE_INTERVAL_MS=3600000
SUPPORT_PUSH_NOTIFICATIONS=true
SHIPPING_PUSH_NOTIFICATIONS=true
VIRTUAL_TRY_ON_PUSH_NOTIFICATIONS=true
EXPO_ACCESS_TOKEN=
ORDER_PAYMENT_DEADLINE_DAYS=3
ORDER_PAYMENT_DEADLINE_WARNING_HOURS=24
ORDER_PAYMENT_DEADLINE_SCHEDULER_INTERVAL_MS=300000
ORDER_PAYMENT_DEADLINE_SCHEDULER=true
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
OTP_HASH_SECRET=replace-with-a-long-random-otp-secret
PAYMENT_METHOD_ENCRYPTION_SECRET=replace-with-a-long-random-payment-method-secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
ADMIN_INITIAL_PASSWORD=
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_AVATAR_FOLDER=fashion-system/avatars
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

INTERACTION_TRACKING_ENABLED=true
SEARCH_HISTORY_ENABLED=true
SEARCH_HISTORY_TTL_SECONDS=7776000
SEARCH_HISTORY_MAX_RESULT_PRODUCTS=100

# Use mock for local mobile testing. Use /fashionshop-tryon to call the real Comfy Cloud workflow.
VIRTUAL_TRY_ON_PROVIDER=mock
VIRTUAL_TRY_ON_SERVICE_URL=
# Comfy Cloud/Partner Node API key. Sent as X-API-Key and extra_data.api_key_comfy_org.
VIRTUAL_TRY_ON_API_KEY=
VIRTUAL_TRY_ON_ENABLE_VIDEO=false
VIRTUAL_TRY_ON_VIDEO_PROVIDER=comfy_kling
# Add these two files after exporting your Kling I2V workflow in ComfyUI API format.
# Keep video disabled until both paths point to real files.
VIRTUAL_TRY_ON_VIDEO_COMFY_WORKFLOW_PATH=config/comfy-workflows/fashion-tryon-kling-v3-i2v-api.json
VIRTUAL_TRY_ON_VIDEO_COMFY_WORKFLOW_MAP_PATH=config/comfy-workflows/fashion-tryon-kling-v3-i2v-map.json
VIRTUAL_TRY_ON_VIDEO_MODEL=kling-v3-omni
# Optional exact node value, for example 5 or 5s depending on the exported workflow.
VIRTUAL_TRY_ON_VIDEO_DURATION=
VIRTUAL_TRY_ON_VIDEO_DURATION_SECONDS=5
VIRTUAL_TRY_ON_VIDEO_RESOLUTION=720p
VIRTUAL_TRY_ON_VIDEO_ASPECT_RATIO=9:16
VIRTUAL_TRY_ON_VIDEO_MODE=
VIRTUAL_TRY_ON_VIDEO_GENERATE_AUDIO=false
VIRTUAL_TRY_ON_VIDEO_TIMEOUT_MS=600000
VIRTUAL_TRY_ON_VIDEO_POLL_INTERVAL_MS=4000
VIRTUAL_TRY_ON_MAX_VIDEO_JOBS_PER_USER_PER_DAY=3
VIRTUAL_TRY_ON_MAX_CONCURRENT_VIDEO_JOBS_PER_USER=1
# Used only with VIRTUAL_TRY_ON_VIDEO_PROVIDER=mock for local mobile testing.
VIRTUAL_TRY_ON_MOCK_VIDEO_URL=
VIRTUAL_TRY_ON_MAX_SELECTED_ITEMS=4
VIRTUAL_TRY_ON_MAX_CONCURRENT_JOBS_PER_USER=1
VIRTUAL_TRY_ON_COMFY_BASE_URL=http://127.0.0.1:8188
VIRTUAL_TRY_ON_COMFY_WORKFLOW_PATH=config/comfy-workflows/fashion-tryon-gemini-4in1-api.json
VIRTUAL_TRY_ON_COMFY_WORKFLOW_MAP_PATH=config/comfy-workflows/fashion-tryon-gemini-4in1-map.json
# Optional Comfy Gemini node override. Leave empty to use the workflow default.
# Current default: gemini-3-pro-image-preview
# Dropdown alternative: Nano Banana 2 (Gemini 3.1 Flash Image)
VIRTUAL_TRY_ON_COMFY_MODEL=gemini-3-pro-image-preview
VIRTUAL_TRY_ON_COMFY_ASPECT_RATIO=3:4
VIRTUAL_TRY_ON_COMFY_RESOLUTION=4K
VIRTUAL_TRY_ON_COMFY_TIMEOUT_MS=120000
VIRTUAL_TRY_ON_COMFY_POLL_INTERVAL_MS=3000
VIRTUAL_TRY_ON_COMFY_RATE_LIMIT_BACKOFF_MS=8000
VIRTUAL_TRY_ON_COMFY_REQUEST_TIMEOUT_MS=30000
# Optional. Cloud uses /history_v2/{promptId}; local ComfyUI uses /history/{promptId}.
VIRTUAL_TRY_ON_COMFY_HISTORY_PATH=
VIRTUAL_TRY_ON_GARMENT_PROCESSING_URL=http://127.0.0.1:7002/prepare-collage
VIRTUAL_TRY_ON_GARMENT_PROCESSING_TIMEOUT_MS=30000
VIRTUAL_TRY_ON_GARMENT_PROCESSING_FAIL_OPEN=true
# Optional local debug output for extracted catalog items and final garment collage.
VIRTUAL_TRY_ON_GARMENT_PROCESSING_DEBUG_DIR=tmp/virtual-try-on-garments

IMAGE_VALIDATION_PROVIDER=custom_model
IMAGE_VALIDATION_PERSON_SCORE_THRESHOLD=0.5
IMAGE_VALIDATION_MIN_WIDTH=400
IMAGE_VALIDATION_MIN_HEIGHT=400
IMAGE_VALIDATION_BLUR_THRESHOLD=100
IMAGE_VALIDATION_BRIGHTNESS_MIN=40
IMAGE_VALIDATION_BRIGHTNESS_MAX=220
IMAGE_VALIDATION_FAIL_OPEN=false
# Set IMAGE_VALIDATION_PROVIDER=mock only for isolated local UI/API tests.
IMAGE_VALIDATION_MOCK_REASON_CODE=
IMAGE_VALIDATION_CUSTOM_MODEL_URL=http://127.0.0.1:7001/validate-image
IMAGE_VALIDATION_CUSTOM_MODEL_TIMEOUT_MS=15000

VNPAY_TMN_CODE=your-tmn-code
VNPAY_HASH_SECRET=your-hash-secret
VNPAY_PAY_URL=your-pay-url
VNPAY_TRANSACTION_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# Set this to an ngrok/cloudflared/domain URL for mobile VNPay testing.
# When set, backend generates VNPAY_RETURN_URL from this public base URL.
VNPAY_PUBLIC_BASE_URL=
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay/return
# Sau khi backend xác thực kết quả VNPay, trình duyệt được chuyển về trang chi tiết đơn hàng tại đây.
# CUSTOMER_FRONTEND_URL=http://localhost:5173
VNPAY_MOBILE_RETURN_URL=fashion-ecommerce://payment-return
VNPAY_IPN_URL=http://localhost:5000/api/payments/vnpay/ipn
VNPAY_SERVER_IP=127.0.0.1
# Explicit opt-in: enable only after VNPAY_TRANSACTION_API_URL and public callbacks are configured.
VNPAY_RECONCILE_SCHEDULER=false
VNPAY_RECONCILE_INTERVAL_MS=600000
VNPAY_RECONCILE_STALE_MINUTES=20
VNPAY_RECONCILE_RETRY_MINUTES=15
VNPAY_RECONCILE_BATCH_SIZE=25
VNPAY_RECONCILE_LOCK_TTL_MS=600000

GHN_BASE_URL=your-ghn-base-url
GHN_TOKEN=your-ghn-token
GHN_SHOP_ID=your-ghn-shop-id
GHN_AVAILABLE_SERVICES_CACHE_TTL_MS=600000
GHN_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
# Configure GHN's callback as: https://public-host/api/shipping/webhooks/ghn?token=<GHN_WEBHOOK_SECRET>
SHIPPING_WEBHOOK_SECRET=replace-with-a-long-random-simulated-webhook-secret
SHIPPING_RECONCILE_SCHEDULER=true
SHIPPING_RECONCILE_INTERVAL_MS=600000
SHIPPING_RECONCILE_STALE_MINUTES=30
SHIPPING_RECONCILE_BATCH_SIZE=50
SHIPPING_RECONCILE_LOCK_TTL_MS=900000
ORDER_AUTO_COMPLETE_SCHEDULER=true
ORDER_AUTO_COMPLETE_INTERVAL_MS=3600000

SHOP_NAME=your-shop-name
SHOP_LEGAL_NAME=
SHOP_TAX_CODE=
SHOP_TAGLINE=
SHOP_DESCRIPTION=
SHOP_PHONE=your-shop-phone
SHOP_EMAIL=
SHOP_HOURS=
SHOP_ADDRESS=your-shop-address
